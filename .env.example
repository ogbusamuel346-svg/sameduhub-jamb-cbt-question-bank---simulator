# OPENROUTER_API_KEY: Required for AI question generation.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
# Optional: OpenRouter model alias or model ID.
OPENROUTER_MODEL="~openai/gpt-latest"
# Optional attribution headers for OpenRouter.
OPENROUTER_SITE_URL="MY_APP_URL"
OPENROUTER_SITE_NAME="SamEduHub"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon Serverless Postgres connection string.
# Pull this from the linked Neon branch with `neon env pull`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Supabase Auth project settings. The publishable key is safe for browser use;
# never put a Supabase secret/service-role key in VITE_* variables.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Optional server-side aliases. If omitted, the API uses the VITE_* values
# above, which are also available to the Vercel function.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Comma-separated Supabase emails that should receive the admin role when
# their Neon profile is first created.
AUTH_ADMIN_EMAILS=""
