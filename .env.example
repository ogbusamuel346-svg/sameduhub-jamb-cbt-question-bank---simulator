# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional: override the server-side model used by the admin generator.
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon Serverless Postgres connection string.
# Pull this from the linked Neon branch with `neon env pull`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Comma-separated emails that should receive the admin role at signup.
# Leave empty in production unless these addresses are controlled by you.
AUTH_ADMIN_EMAILS=""
